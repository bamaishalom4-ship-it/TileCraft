{
  "name": "tilecraft",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:pwa": "expo export --platform web --output-dir dist && node scripts/inject-pwa-head.mjs",
    "typecheck": "tsc --noEmit",
    "test:engine": "node --import ./scripts/ts-resolve.mjs --test src/engine/__tests__/puzzleEngine.test.ts src/utils/__tests__/imageCropUtils.test.ts src/utils/__tests__/marketplaceUtils.test.ts src/utils/__tests__/economyUtils.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.47.10",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-google-mobile-ads": "^14.7.0",
    "react-native-purchases": "^8.5.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.6.3"
  },
  "private": true
}

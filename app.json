{
  "expo": {
    "name": "TileCraft",
    "slug": "tilecraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tilecraft.puzzle"
    },
    "android": {
      "package": "com.tilecraft.puzzle",
      "adaptiveIcon": {
        "backgroundColor": "#141824"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "TileCraft",
      "shortName": "TileCraft",
      "description": "Tactile sliding tile puzzle with custom image cropping and UGC marketplace.",
      "themeColor": "#0F131D",
      "backgroundColor": "#0F131D",
      "display": "standalone",
      "orientation": "portrait",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TileCraft needs access to your photos so you can craft custom sliding puzzles."
        }
      ],
      "expo-sqlite",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ]
  }
}

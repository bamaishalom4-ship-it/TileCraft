{
  "expo": {
    "name": "TileCraft",
    "slug": "tilecraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tilecraft.puzzle"
    },
    "android": {
      "package": "com.tilecraft.puzzle",
      "adaptiveIcon": {
        "backgroundColor": "#141824"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TileCraft needs access to your photos so you can craft custom sliding puzzles."
        }
      ]
    ]
  }
}
